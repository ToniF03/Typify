<Application x:Class="Typify.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Typify"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#F3F3F3" />
            <SolidColorBrush x:Key="SidebarBrush" Color="#F3F3F3" />
            <SolidColorBrush x:Key="BorderBrush" Color="#E5E5E5" />
            <SolidColorBrush x:Key="TextBrush" Color="#333333" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#616161" />
            <SolidColorBrush x:Key="AccentBrush" Color="#007ACC" />
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#0062A3" />
            <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="GitBrush" Color="#F03C2E" />
            <SolidColorBrush x:Key="HoverBrush" Color="#E8E8E8" />
            <SolidColorBrush x:Key="SelectedBrush" Color="#E4E6F1" />
            <SolidColorBrush x:Key="EditorBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="EditorTextBrush" Color="#333333" />
            <SolidColorBrush x:Key="DiagnosticBackgroundBrush" Color="#FFF2F1" />
            <SolidColorBrush x:Key="DiagnosticTextBrush" Color="#CF222E" />
            <SolidColorBrush x:Key="PreviewPageBorderBrush" Color="#E5E5E5" />
            <SolidColorBrush x:Key="WindowCaptionButtonHoverBrush" Color="#E0E0E0" />
            <SolidColorBrush x:Key="WindowCloseButtonHoverBrush" Color="#C42B1C" />

            <SolidColorBrush x:Key="VsBackgroundBrush" Color="#1E1E1E" />
            <SolidColorBrush x:Key="VsSidebarBrush" Color="#252526" />
            <SolidColorBrush x:Key="VsHeaderBrush" Color="#252526" />
            <SolidColorBrush x:Key="VsBorderBrush" Color="#2B2B2B" />
            <SolidColorBrush x:Key="VsTextBrush" Color="#CCCCCC" />
            <SolidColorBrush x:Key="VsMutedTextBrush" Color="#858585" />
            <SolidColorBrush x:Key="VsPrimaryButtonBrush" Color="#0E639C" />
            <SolidColorBrush x:Key="VsPrimaryButtonHoverBrush" Color="#1177BB" />
            <SolidColorBrush x:Key="VsPrimaryButtonTextBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="VsSecondaryButtonBrush" Color="#3A3D41" />
            <SolidColorBrush x:Key="VsSecondaryButtonHoverBrush" Color="#45494E" />
            <SolidColorBrush x:Key="VsIconButtonHoverBrush" Color="#333333" />
            <SolidColorBrush x:Key="VsInputBackgroundBrush" Color="#3C3C3C" />
            <SolidColorBrush x:Key="VsInputBorderBrush" Color="#3C3C3C" />
            <SolidColorBrush x:Key="VsInputFocusBorderBrush" Color="#007FD4" />
            <SolidColorBrush x:Key="VsPlaceholderBrush" Color="#858585" />
            <SolidColorBrush x:Key="VsListHoverBrush" Color="#2A2D2E" />
            <SolidColorBrush x:Key="VsListSelectedBrush" Color="#094771" />
            <SolidColorBrush x:Key="VsTabActiveBorderBrush" Color="#007FD4" />
            <SolidColorBrush x:Key="VsWarningBrush" Color="#CCA700" />
            <SolidColorBrush x:Key="VsErrorBrush" Color="#F14C4C" />
            <SolidColorBrush x:Key="VsSuccessBrush" Color="#89D185" />
            <SolidColorBrush x:Key="VsBannerBackgroundBrush" Color="#1C2D42" />
            <SolidColorBrush x:Key="VsBannerTextBrush" Color="#9CDCFE" />
            <SolidColorBrush x:Key="VsStatusModifiedBrush" Color="#E2C08D" />
            <SolidColorBrush x:Key="VsStatusUntrackedBrush" Color="#73C991" />
            <SolidColorBrush x:Key="VsStatusAddedBrush" Color="#73C991" />
            <SolidColorBrush x:Key="VsStatusDeletedBrush" Color="#C74E39" />
            <SolidColorBrush x:Key="VsStatusRenamedBrush" Color="#4EC9B0" />

            <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="PrimaryChrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="PrimaryChrome" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                                    <Setter TargetName="PrimaryChrome" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="PrimaryChrome" Property="Opacity" Value="0.82" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="PrimaryChrome" Property="Opacity" Value="0.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="WindowCaptionButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="46" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="CaptionButtonChrome" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CaptionButtonChrome" Property="Background" Value="{DynamicResource WindowCaptionButtonHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="CaptionButtonChrome" Property="Opacity" Value="0.8" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="WindowCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowCaptionButtonStyle}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="CaptionButtonChrome" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CaptionButtonChrome" Property="Background" Value="{DynamicResource WindowCloseButtonHoverBrush}" />
                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="CaptionButtonChrome" Property="Opacity" Value="0.8" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
