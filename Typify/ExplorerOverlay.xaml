<UserControl x:Class="Typify.ExplorerOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Typify"
             mc:Ignorable="d" 
             FontFamily="Segoe UI" FontSize="12.5"
             IsHitTestVisible="True"
             HorizontalAlignment="Left" VerticalAlignment="Stretch">
    <UserControl.Resources>
        <!-- VS Code / Visual Studio Theme Palettes (dynamically updated in code-behind via ApplyTheme) -->
        <SolidColorBrush x:Key="VsBackgroundBrush" Color="#1E1E1E" />
        <SolidColorBrush x:Key="VsSidebarBrush" Color="#252526" />
        <SolidColorBrush x:Key="VsHeaderBrush" Color="#252526" />
        <SolidColorBrush x:Key="VsBorderBrush" Color="#2B2B2B" />
        <SolidColorBrush x:Key="VsTextBrush" Color="#CCCCCC" />
        <SolidColorBrush x:Key="VsMutedTextBrush" Color="#858585" />
        <SolidColorBrush x:Key="VsPrimaryButtonBrush" Color="#0E639C" />
        <SolidColorBrush x:Key="VsPrimaryButtonHoverBrush" Color="#1177BB" />
        <SolidColorBrush x:Key="VsPrimaryButtonTextBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="VsSecondaryButtonBrush" Color="#3A3D41" />
        <SolidColorBrush x:Key="VsSecondaryButtonHoverBrush" Color="#45494E" />
        <SolidColorBrush x:Key="VsIconButtonHoverBrush" Color="#333333" />
        <SolidColorBrush x:Key="VsInputBackgroundBrush" Color="#3C3C3C" />
        <SolidColorBrush x:Key="VsInputBorderBrush" Color="#3C3C3C" />
        <SolidColorBrush x:Key="VsInputFocusBorderBrush" Color="#007FD4" />
        <SolidColorBrush x:Key="VsPlaceholderBrush" Color="#858585" />
        <SolidColorBrush x:Key="VsListHoverBrush" Color="#2A2D2E" />
        <SolidColorBrush x:Key="VsListSelectedBrush" Color="#094771" />
        <SolidColorBrush x:Key="VsTabActiveBorderBrush" Color="#007FD4" />
        <SolidColorBrush x:Key="VsWarningBrush" Color="#CCA700" />
        <SolidColorBrush x:Key="VsErrorBrush" Color="#F14C4C" />
        <SolidColorBrush x:Key="VsSuccessBrush" Color="#89D185" />
        <SolidColorBrush x:Key="VsBannerBackgroundBrush" Color="#1C2D42" />
        <SolidColorBrush x:Key="VsBannerTextBrush" Color="#9CDCFE" />
        <Geometry x:Key="TreeChevronRightGeometry">M4,2 L8,6 L4,10</Geometry>
        <Geometry x:Key="TreeChevronDownGeometry">M2,4 L6,8 L10,4</Geometry>

        <Style x:Key="ExplorerTreeExpanderStyle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ClickMode" Value="Press" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Width="16" Height="20" Background="Transparent">
                            <Path x:Name="Chevron" Data="{StaticResource TreeChevronRightGeometry}"
                                  Stroke="{DynamicResource VsMutedTextBrush}" StrokeThickness="1.4"
                                  StrokeLineJoin="Round" HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chevron" Property="Data"
                                        Value="{StaticResource TreeChevronDownGeometry}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chevron" Property="Stroke"
                                        Value="{DynamicResource VsTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chevron" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ExplorerTreeViewItemStyle" TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="{DynamicResource VsTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ToggleButton x:Name="Expander" Grid.Row="0" Grid.Column="0"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Style="{StaticResource ExplorerTreeExpanderStyle}"
                                          Visibility="Collapsed" />
                            <Border x:Name="HeaderBorder" Grid.Row="0" Grid.Column="1"
                                    Background="{TemplateBinding Background}" Padding="4,2"
                                    CornerRadius="2">
                                <ContentPresenter x:Name="PART_Header" ContentSource="Header"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1"
                                            Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="True">
                                <Setter TargetName="Expander" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background"
                                        Value="{DynamicResource VsListHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background"
                                        Value="{DynamicResource VsListSelectedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource VsMutedTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Icon Button Style -->
        <Style x:Key="VsIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource VsTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="1" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource VsIconButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VsSearchTextBox" TargetType="TextBox">
            <!--<Setter Property="Background" Value="{DynamicResource VsInputBackgroundBrush}" />-->
            <Setter Property="Foreground" Value="{DynamicResource VsTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Tag" Value="Search files..." />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="4,0,0,0" />
                            <TextBlock x:Name="Watermark"
                                       Text="{TemplateBinding Tag}"
                                       Foreground="{DynamicResource VsPlaceholderBrush}"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Center"
                                       Margin="4,0,0,0"
                                       Opacity="0"
                                       TextWrapping="Wrap" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Watermark" Property="Opacity" Value="0" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="False">
                                <Setter TargetName="Watermark" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="Text" Value="{x:Null}">
                                <Setter Property="Foreground" Value="{DynamicResource VsPlaceholderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border x:Name="OverlayWindowCard" HorizontalAlignment="Left" VerticalAlignment="Stretch"
           Width="360" Background="{DynamicResource VsBackgroundBrush}"
           BorderBrush="{DynamicResource VsBorderBrush}" BorderThickness="0,0,1,0"
           CornerRadius="0,6,6,0" SnapsToDevicePixels="True" Visibility="Visible">
        <Border.RenderTransform>
            <TranslateTransform x:Name="WindowTransform" X="0" Y="0" />
        </Border.RenderTransform>
        <Border.Effect>
            <!-- Drop shadow cast to the right over the main workspace -->
            <DropShadowEffect Color="#000000" Direction="0" BlurRadius="20" ShadowDepth="1" Opacity="0.15" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <!-- Row 0: Window Header -->
                <RowDefinition Height="36" />
                <RowDefinition Height="36" />
                <!-- Row 2: Scrollable body (message, options, staged & unstaged accordions) -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ROW 0: WINDOW HEADER BAR (Draggable, double-click to re-dock) -->
            <Border Grid.Row="0" x:Name="TabHeaderBar" Background="{DynamicResource VsHeaderBrush}"
                   BorderBrush="{DynamicResource VsBorderBrush}" BorderThickness="0,0,0,1"
                   CornerRadius="0,6,0,0">
                <Grid Margin="10,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Title: Git Changes - <Repo> -->
                    <TextBlock x:Name="TitleText" Text="Explorer" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource VsTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />


                    <!-- Controls: Dock/Reset, Close -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="RefreshButton" Style="{StaticResource VsIconButton}" ToolTip="Refresh" Margin="0,0,2,0" Click="RefreshExplorer_Click">
                            <TextBlock Text="↻" FontSize="10" Foreground="{DynamicResource VsMutedTextBrush}" />
                        </Button>
                        <Button x:Name="DockButton" Style="{StaticResource VsIconButton}" ToolTip="Dock to left edge"
                                Margin="0,0,2,0" Click="DockButton_Click">
                            <TextBlock x:Name="DockButtonIcon" Text="📌" FontSize="10" Foreground="{DynamicResource VsMutedTextBrush}" />
                        </Button>
                        <Button Style="{StaticResource VsIconButton}" ToolTip="Close (Esc)" Click="CloseButton_Click">
                            <TextBlock Text="✕" FontSize="11" Foreground="{DynamicResource VsMutedTextBrush}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Margin="10, 8" BorderBrush="{DynamicResource VsBorderBrush}" BorderThickness="1">
                <Grid Background="{DynamicResource VsInputBackgroundBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchTextBox" Grid.Column="0" Style="{DynamicResource VsSearchTextBox}" Margin="4,0,0,0" TextChanged="SearchTextBox_TextChanged" />
                    <Button x:Name="SearchButton" Grid.Column="1" Style="{StaticResource VsIconButton}" ToolTip="Search" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0">
                        <TextBlock Text="🔍" FontSize="10" Foreground="{DynamicResource VsMutedTextBrush}" />
                    </Button>
                </Grid>
            </Border>

            <TreeView x:Name="ProjectTree" Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Background="Transparent" Margin="10, 8"
                      ItemContainerStyle="{StaticResource ExplorerTreeViewItemStyle}" />
            <StackPanel x:Name="OpenFilePanel" Grid.Row="2" Margin="10,8" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock TextWrapping="Wrap" TextAlignment="Center" Margin="0,8">There is currently no working directory selected.</TextBlock>
                <Button>Open a Working Directory</Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
