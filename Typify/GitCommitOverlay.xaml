<UserControl x:Class="Typify.GitCommitOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             FontFamily="Segoe UI" FontSize="12.5"
             IsHitTestVisible="True"
             HorizontalAlignment="Left" VerticalAlignment="Stretch">
    <UserControl.Resources>
        <!-- VS Code / Visual Studio Theme Palettes (dynamically updated in code-behind via ApplyTheme) -->
        <SolidColorBrush x:Key="VsBackgroundBrush" Color="#1E1E1E" />
        <SolidColorBrush x:Key="VsSidebarBrush" Color="#252526" />
        <SolidColorBrush x:Key="VsHeaderBrush" Color="#252526" />
        <SolidColorBrush x:Key="VsBorderBrush" Color="#2B2B2B" />
        <SolidColorBrush x:Key="VsTextBrush" Color="#CCCCCC" />
        <SolidColorBrush x:Key="VsMutedTextBrush" Color="#858585" />
        <SolidColorBrush x:Key="VsPrimaryButtonBrush" Color="#0E639C" />
        <SolidColorBrush x:Key="VsPrimaryButtonHoverBrush" Color="#1177BB" />
        <SolidColorBrush x:Key="VsPrimaryButtonTextBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="VsSecondaryButtonBrush" Color="#3A3D41" />
        <SolidColorBrush x:Key="VsSecondaryButtonHoverBrush" Color="#45494E" />
        <SolidColorBrush x:Key="VsIconButtonHoverBrush" Color="#333333" />
        <SolidColorBrush x:Key="VsInputBackgroundBrush" Color="#3C3C3C" />
        <SolidColorBrush x:Key="VsInputBorderBrush" Color="#3C3C3C" />
        <SolidColorBrush x:Key="VsInputFocusBorderBrush" Color="#007FD4" />
        <SolidColorBrush x:Key="VsPlaceholderBrush" Color="#858585" />
        <SolidColorBrush x:Key="VsListHoverBrush" Color="#2A2D2E" />
        <SolidColorBrush x:Key="VsListSelectedBrush" Color="#094771" />
        <SolidColorBrush x:Key="VsTabActiveBorderBrush" Color="#007FD4" />
        <SolidColorBrush x:Key="VsWarningBrush" Color="#CCA700" />
        <SolidColorBrush x:Key="VsErrorBrush" Color="#F14C4C" />
        <SolidColorBrush x:Key="VsSuccessBrush" Color="#89D185" />
        <SolidColorBrush x:Key="VsBannerBackgroundBrush" Color="#1C2D42" />
        <SolidColorBrush x:Key="VsBannerTextBrush" Color="#9CDCFE" />

        <SolidColorBrush x:Key="VsStatusModifiedBrush" Color="#E2C08D" />
        <SolidColorBrush x:Key="VsStatusUntrackedBrush" Color="#73C991" />
        <SolidColorBrush x:Key="VsStatusAddedBrush" Color="#73C991" />
        <SolidColorBrush x:Key="VsStatusDeletedBrush" Color="#C74E39" />
        <SolidColorBrush x:Key="VsStatusRenamedBrush" Color="#4EC9B0" />

        <!-- Primary Button Style -->
        <Style x:Key="VsPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource VsPrimaryButtonBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource VsPrimaryButtonTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource VsPrimaryButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="VsSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource VsSecondaryButtonBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource VsTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource VsSecondaryButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Icon Button Style -->
        <Style x:Key="VsIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource VsTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="1" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource VsIconButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Textbox Style -->
        <Style x:Key="VsInputBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource VsInputBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource VsTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource VsInputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="CaretBrush" Value="{DynamicResource VsTextBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource VsPrimaryButtonBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource VsInputFocusBorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CheckBox Style -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource VsTextBrush}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <!-- OVERLAPPING GIT CHANGES WINDOW (Docked on the left, overlapping content) -->
    <Border x:Name="OverlayWindowCard" HorizontalAlignment="Left" VerticalAlignment="Stretch"
            Width="360" Background="{DynamicResource VsBackgroundBrush}"
            BorderBrush="{DynamicResource VsBorderBrush}" BorderThickness="0,0,1,0"
            CornerRadius="0,6,6,0" SnapsToDevicePixels="True" Visibility="Visible">
        <Border.RenderTransform>
            <TranslateTransform x:Name="WindowTransform" X="0" Y="0" />
        </Border.RenderTransform>
        <Border.Effect>
            <!-- Drop shadow cast to the right over the main workspace -->
            <DropShadowEffect Color="#000000" Direction="0" BlurRadius="20" ShadowDepth="1" Opacity="0.15" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <!-- Row 0: Window Header -->
                <RowDefinition Height="36" />
                <!-- Row 1: Optional Notification Banner -->
                <RowDefinition Height="Auto" />
                <!-- Row 2: Branch & Sync toolbar -->
                <RowDefinition Height="Auto" />
                <!-- Row 3: Scrollable body (message, options, staged & unstaged accordions) -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ROW 0: WINDOW HEADER BAR (Draggable, double-click to re-dock) -->
            <Border Grid.Row="0" x:Name="TabHeaderBar" Background="{DynamicResource VsHeaderBrush}"
                    BorderBrush="{DynamicResource VsBorderBrush}" BorderThickness="0,0,0,1"
                    CornerRadius="0,6,0,0">
                <Grid Margin="10,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Title: Git Changes - <Repo> -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⑂" FontSize="13" Foreground="{DynamicResource VsPrimaryButtonBrush}" Margin="0,0,6,0" VerticalAlignment="Center" FontWeight="Bold" />
                        <TextBlock x:Name="TitleText" Text="Git Changes - Typify" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource VsTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Ellipse x:Name="DirtyIndicator" Width="6" Height="6" Fill="{DynamicResource VsTabActiveBorderBrush}" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                    </StackPanel>

                    <!-- Controls: Dock/Reset, Close -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="DockButton" Style="{StaticResource VsIconButton}" ToolTip="Dock to left edge"
                                Margin="0,0,2,0" Click="DockButton_Click">
                            <TextBlock x:Name="DockButtonIcon" Text="📌" FontSize="10" Foreground="{DynamicResource VsMutedTextBrush}" />
                        </Button>
                        <Button Style="{StaticResource VsIconButton}" ToolTip="Close (Esc)" Click="CloseButton_Click">
                            <TextBlock Text="✕" FontSize="11" Foreground="{DynamicResource VsMutedTextBrush}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ROW 1: STATUS / NOTIFICATION BANNER (Like in VS Git Changes) -->
            <Border x:Name="NotificationBanner" Grid.Row="1" Background="{DynamicResource VsBannerBackgroundBrush}"
                    BorderBrush="{DynamicResource VsBorderBrush}" BorderThickness="0,0,0,1"
                    Padding="10,7" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="ℹ" FontSize="12" Foreground="{DynamicResource VsBannerTextBrush}" Margin="0,0,8,0" VerticalAlignment="Top" />
                    <TextBlock x:Name="NotificationBannerText" Grid.Column="1" Text="Successfully committed."
                               FontSize="11.5" Foreground="{DynamicResource VsBannerTextBrush}" TextWrapping="Wrap" />
                    <Button Grid.Column="2" Style="{StaticResource VsIconButton}" Width="18" Height="18"
                            ToolTip="Dismiss" Click="DismissNotification_Click" VerticalAlignment="Top">
                        <TextBlock Text="✕" FontSize="9.5" Foreground="{DynamicResource VsBannerTextBrush}" />
                    </Button>
                </Grid>
            </Border>

            <!-- ROW 2: BRANCH & SYNC TOOLBAR (Visual Studio Style) -->
            <Border Grid.Row="2" Background="{DynamicResource VsSidebarBrush}"
                    BorderBrush="{DynamicResource VsBorderBrush}" BorderThickness="0,0,0,1"
                    Padding="10,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Current Branch selector -->
                    <Border Background="{DynamicResource VsBackgroundBrush}" BorderBrush="{DynamicResource VsBorderBrush}"
                            BorderThickness="1" CornerRadius="3" Padding="7,3" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⑂" FontSize="11.5" Foreground="{DynamicResource VsPrimaryButtonBrush}" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="BranchLabel" Text="main" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource VsTextBrush}" VerticalAlignment="Center" MaxWidth="160" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>

                    <!-- Right: Pull, Push, Refresh Sync buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource VsIconButton}" ToolTip="Pull from remote (git pull)" Click="PullButton_Click" Margin="0,0,2,0">
                            <TextBlock Text="↓" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource VsTextBrush}" />
                        </Button>
                        <Button Style="{StaticResource VsIconButton}" ToolTip="Push to remote (git push)" Click="PushButton_Click" Margin="0,0,2,0">
                            <TextBlock Text="↑" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource VsTextBrush}" />
                        </Button>
                        <Button Style="{StaticResource VsIconButton}" ToolTip="Refresh Git Changes" Click="RefreshButton_Click">
                            <TextBlock Text="↻" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource VsTextBrush}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ROW 3: SCROLLABLE MAIN BODY -->
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="10,8">
                <StackPanel>
                    <!-- 1. COMMIT MESSAGE BOX (Visual Studio: Enter a message <Required>) -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="COMMIT MESSAGE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource VsMutedTextBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="SubjectCharCounter" Grid.Column="1" Text="0/50" FontSize="10" Foreground="{DynamicResource VsMutedTextBrush}" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <TextBox x:Name="SubjectTextBox" Style="{StaticResource VsInputBoxStyle}" Height="54"
                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 FontSize="12" Padding="7,5"
                                 TextChanged="SubjectTextBox_TextChanged"
                                 KeyDown="CommitInputs_KeyDown" />
                        <TextBlock x:Name="SubjectPlaceholder" Text="Enter a message &lt;Required&gt;"
                                   Foreground="{DynamicResource VsPlaceholderBrush}" FontSize="11.5"
                                   Margin="9,6,0,0" IsHitTestVisible="False" VerticalAlignment="Top" />
                    </Grid>

                    <!-- Expandable Description / Co-author toggle -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource VsIconButton}" Width="Auto" Height="Auto" Padding="2,1" Click="ToggleDescriptionBox_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="DescriptionToggleIcon" Text="▸" FontSize="9" Margin="0,1,4,0" Foreground="{DynamicResource VsMutedTextBrush}" />
                                <TextBlock Text="Extended Description" FontSize="10.5" Foreground="{DynamicResource VsMutedTextBrush}" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Style="{StaticResource VsIconButton}" Width="Auto" Height="Auto" Padding="4,1" ToolTip="Add Co-authored-by trailer" Click="AddCoAuthor_Click">
                            <TextBlock Text="+ Co-author" FontSize="10.5" Foreground="{DynamicResource VsPrimaryButtonBrush}" FontWeight="SemiBold" />
                        </Button>
                    </Grid>

                    <!-- Description Text Box (Collapsible) -->
                    <TextBox x:Name="BodyTextBox" Style="{StaticResource VsInputBoxStyle}" Height="64"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="11" Margin="0,0,0,8"
                             TextChanged="BodyTextBox_TextChanged"
                             KeyDown="CommitInputs_KeyDown" Visibility="Collapsed" />

                    <!-- 2. ACTION ROW: [Commit Staged] button + [ ] Amend -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="ExecuteCommitButton" Style="{StaticResource VsPrimaryButtonStyle}"
                                    Content="Commit Staged" Click="CommitButton_Click" Height="26" Padding="12,3" />
                            <Button x:Name="CommitAndPushButton" Style="{StaticResource VsSecondaryButtonStyle}"
                                    Content="Commit &amp; Push" Click="CommitAndPush_Click" Margin="6,0,0,0" Height="26" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox x:Name="AmendCheckBox" Content="Amend" Click="AmendCheckBox_Click" Margin="0,0,6,0" ToolTip="Amend last commit" />
                            <CheckBox x:Name="SignOffCheckBox" Content="Sign-off" ToolTip="Add Signed-off-by trailer" />
                        </StackPanel>
                    </Grid>

                    <!-- 3. STAGED CHANGES ACCORDION (Like VS: Staged Changes (8)) -->
                    <Border Background="{DynamicResource VsSidebarBrush}" BorderBrush="{DynamicResource VsBorderBrush}"
                            BorderThickness="1" CornerRadius="4" Margin="0,0,0,8">
                        <StackPanel>
                            <!-- Expander Header -->
                            <Border Padding="8,5" Cursor="Hand" MouseLeftButtonDown="StagedSummaryHeader_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="StagedExpanderIcon" Text="▾" FontSize="11" Margin="0,0,6,0" Foreground="{DynamicResource VsMutedTextBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="Staged Changes" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource VsTextBrush}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="StagedCountBracket" Text=" (0)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource VsTextBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource VsIconButton}" Content="−" Width="18" Height="18"
                                                ToolTip="Unstage all files" Click="UnstageAll_Click" Margin="0,0,4,0" />
                                        <Button x:Name="StageAllNowButton" Style="{StaticResource VsIconButton}" Content="+" Width="18" Height="18"
                                                ToolTip="Stage all files" Click="StageAllNowButton_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Staged Files List -->
                            <ListBox x:Name="StagedFilesListBox" MaxHeight="160" Background="Transparent" BorderThickness="0"
                                     Padding="4,2" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="22">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="📄" FontSize="11" Foreground="{DynamicResource VsMutedTextBrush}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding FileName}" FontSize="11.5" Foreground="{DynamicResource VsTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding DirectoryDisplay}" FontSize="10.5" Foreground="{DynamicResource VsMutedTextBrush}" Margin="6,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="16" Height="16" Margin="0,0,4,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StatusLetter}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource VsTextBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding StatusLetter}" Value="M"><Setter Property="Foreground" Value="{DynamicResource VsStatusModifiedBrush}" /></DataTrigger>
                                                                    <DataTrigger Binding="{Binding StatusLetter}" Value="A"><Setter Property="Foreground" Value="{DynamicResource VsStatusAddedBrush}" /></DataTrigger>
                                                                    <DataTrigger Binding="{Binding StatusLetter}" Value="D"><Setter Property="Foreground" Value="{DynamicResource VsStatusDeletedBrush}" /></DataTrigger>
                                                                    <DataTrigger Binding="{Binding StatusLetter}" Value="R"><Setter Property="Foreground" Value="{DynamicResource VsStatusRenamedBrush}" /></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                                <Button Style="{StaticResource VsIconButton}" Content="−" Width="18" Height="18"
                                                        ToolTip="Unstage this file" Click="UnstageFile_Click" Tag="{Binding Path}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Notice when 0 files staged -->
                            <Border x:Name="ZeroStagedNotice" Padding="10,6" Visibility="Collapsed">
                                <TextBlock Text="No staged changes. If you commit now, all working changes will be automatically staged."
                                           FontSize="10.5" Foreground="{DynamicResource VsWarningBrush}" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 4. UNSTAGED CHANGES ACCORDION (Like VS: Changes) -->
                    <Border Background="{DynamicResource VsSidebarBrush}" BorderBrush="{DynamicResource VsBorderBrush}"
                            BorderThickness="1" CornerRadius="4" Margin="0,0,0,4">
                        <StackPanel>
                            <!-- Expander Header -->
                            <Border Padding="8,5" Cursor="Hand" MouseLeftButtonDown="UnstagedSummaryHeader_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="UnstagedExpanderIcon" Text="▾" FontSize="11" Margin="0,0,6,0" Foreground="{DynamicResource VsMutedTextBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="Changes" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource VsTextBrush}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="UnstagedCountBracket" Text=" (0)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource VsTextBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource VsIconButton}" Content="+" Width="18" Height="18"
                                                ToolTip="Stage all working changes" Click="StageAllNowButton_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Unstaged Files List -->
                            <ListBox x:Name="UnstagedFilesListBox" MaxHeight="140" Background="Transparent" BorderThickness="0"
                                     Padding="4,2" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="22">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="📄" FontSize="11" Foreground="{DynamicResource VsMutedTextBrush}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding FileName}" FontSize="11.5" Foreground="{DynamicResource VsTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding DirectoryDisplay}" FontSize="10.5" Foreground="{DynamicResource VsMutedTextBrush}" Margin="6,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="16" Height="16" Margin="0,0,4,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StatusLetter}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource VsTextBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding StatusLetter}" Value="M"><Setter Property="Foreground" Value="{DynamicResource VsStatusModifiedBrush}" /></DataTrigger>
                                                                    <DataTrigger Binding="{Binding StatusLetter}" Value="U"><Setter Property="Foreground" Value="{DynamicResource VsStatusUntrackedBrush}" /></DataTrigger>
                                                                    <DataTrigger Binding="{Binding StatusLetter}" Value="D"><Setter Property="Foreground" Value="{DynamicResource VsStatusDeletedBrush}" /></DataTrigger>
                                                                    <DataTrigger Binding="{Binding StatusLetter}" Value="A"><Setter Property="Foreground" Value="{DynamicResource VsStatusAddedBrush}" /></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                                <Button Style="{StaticResource VsIconButton}" Content="+" Width="18" Height="18"
                                                        ToolTip="Stage this file" Click="StageSingleFile_Click" Tag="{Binding Path}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Placeholder when working tree is clean (Visual Studio style text) -->
                            <Border x:Name="NoUnstagedNotice" Padding="10,8" Visibility="Collapsed">
                                <TextBlock Text="There are no unstaged changes in the working directory."
                                           FontSize="11" Foreground="{DynamicResource VsMutedTextBrush}" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
