<UserControl x:Class="Typify.GitTabView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FontFamily="Segoe UI" FontSize="12.5"
        Background="{DynamicResource VsBackgroundBrush}" Foreground="{DynamicResource VsTextBrush}">
    <UserControl.Resources>
        <!-- VS Code Primary Button Style -->
        <Style x:Key="VsPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource VsPrimaryButtonBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource VsPrimaryButtonTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource VsPrimaryButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource VsPrimaryButtonStyle}" />

        <!-- VS Code Secondary Button Style -->
        <Style x:Key="VsSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource VsSecondaryButtonBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource VsTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource VsSecondaryButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- VS Code Small Icon Button Style -->
        <Style x:Key="VsIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource VsTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="1" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource VsIconButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- VS Code Nav Tab Style -->
        <Style x:Key="VsNavTabStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource VsMutedTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource VsTextBrush}" />
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource VsHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource VsTextBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource VsPrimaryButtonBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Default Button -->
        <Style TargetType="Button" BasedOn="{StaticResource VsSecondaryButtonStyle}" />

        <!-- VS Code Textbox -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource VsInputBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource VsTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource VsInputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="CaretBrush" Value="{DynamicResource VsTextBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource VsPrimaryButtonBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource VsInputFocusBorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ListBox -->
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource VsTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <!-- ListBoxItem -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Chrome" Background="Transparent" CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource VsListHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource VsListSelectedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Template for Staged Changes -->
        <DataTemplate x:Key="StagedChangeTemplate">
            <Grid Margin="2,1" Height="22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding FileName}" Foreground="{DynamicResource VsTextBrush}" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding DirectoryDisplay}" Foreground="{DynamicResource VsMutedTextBrush}" Margin="8,0,0,0" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource VsIconButton}" Content="−" ToolTip="Unstage Changes" Click="UnstageItem_Click" Margin="0,0,4,0" />
                    <Border Width="16" Height="16" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusLetter}" ToolTip="{Binding StatusTooltip}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="11">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource VsTextBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusLetter}" Value="M"><Setter Property="Foreground" Value="{DynamicResource VsStatusModifiedBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding StatusLetter}" Value="A"><Setter Property="Foreground" Value="{DynamicResource VsStatusAddedBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding StatusLetter}" Value="D"><Setter Property="Foreground" Value="{DynamicResource VsStatusDeletedBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding StatusLetter}" Value="R"><Setter Property="Foreground" Value="{DynamicResource VsStatusRenamedBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding StatusLetter}" Value="C"><Setter Property="Foreground" Value="{DynamicResource VsStatusRenamedBrush}" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Template for Unstaged Changes -->
        <DataTemplate x:Key="UnstagedChangeTemplate">
            <Grid Margin="2,1" Height="22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding FileName}" Foreground="{DynamicResource VsTextBrush}" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding DirectoryDisplay}" Foreground="{DynamicResource VsMutedTextBrush}" Margin="8,0,0,0" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource VsIconButton}" Content="↩" ToolTip="Discard Changes" Click="DiscardItem_Click" Margin="0,0,2,0" />
                    <Button Style="{StaticResource VsIconButton}" Content="+" ToolTip="Stage Changes" Click="StageItem_Click" Margin="0,0,4,0" />
                    <Border Width="16" Height="16" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusLetter}" ToolTip="{Binding StatusTooltip}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="11">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource VsTextBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusLetter}" Value="M"><Setter Property="Foreground" Value="{DynamicResource VsStatusModifiedBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding StatusLetter}" Value="U"><Setter Property="Foreground" Value="{DynamicResource VsStatusUntrackedBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding StatusLetter}" Value="D"><Setter Property="Foreground" Value="{DynamicResource VsStatusDeletedBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding StatusLetter}" Value="A"><Setter Property="Foreground" Value="{DynamicResource VsStatusAddedBrush}" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="RootLayout">
        <Grid.RowDefinitions>
            <!-- VS Code Top Toolbar / Header -->
            <RowDefinition Height="36" />
            <!-- Main Content Area -->
            <RowDefinition Height="*" />
            <!-- VS Code Bottom Status Bar -->
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>

        <!-- Hidden repository path box for backward-compatibility -->
        <TextBox x:Name="RepositoryPathBox" Visibility="Collapsed" />

        <!-- ROW 0: VS CODE TOP TOOLBAR -->
        <Border Grid.Row="0" Background="{DynamicResource VsSidebarBrush}" BorderBrush="{DynamicResource VsBorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Title and Branch pill -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="SOURCE CONTROL" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource VsTextBrush}" VerticalAlignment="Center" />
                    <!-- Branch Badge -->
                    <Border Background="{DynamicResource VsHoverBrush}" CornerRadius="3" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⑂" FontSize="11" Margin="0,0,4,0" Foreground="{DynamicResource VsMutedTextBrush}" />
                            <TextBlock x:Name="BranchSummary" Text="No repository" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource VsTextBrush}" />
                        </StackPanel>
                    </Border>
                    <!-- Sync Pill -->
                    <Border x:Name="SyncPill" Background="Transparent" CornerRadius="3" Padding="5,2" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock x:Name="SyncText" Text="↓0 ↑0" FontSize="11" Foreground="{DynamicResource VsMutedTextBrush}" />
                    </Border>
                </StackPanel>

                <!-- Center: View Switcher Tabs -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Stretch">
                    <RadioButton x:Name="NavChangesButton" Content="Changes" Style="{StaticResource VsNavTabStyle}" IsChecked="True" Checked="NavButton_Checked" />
                    <RadioButton x:Name="NavCommitsButton" Content="Commits" Style="{StaticResource VsNavTabStyle}" Checked="NavButton_Checked" />
                    <RadioButton x:Name="NavBranchesButton" Content="Branches" Style="{StaticResource VsNavTabStyle}" Checked="NavButton_Checked" />
                    <RadioButton x:Name="NavTerminalButton" Content="Terminal" Style="{StaticResource VsNavTabStyle}" Checked="NavButton_Checked" />
                </StackPanel>

                <!-- Right: Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Button Style="{StaticResource VsIconButton}" Content="↻" ToolTip="Refresh (Refresh repository status)" Click="Refresh_Click" FontSize="14" Width="26" Height="26" />
                    <Button x:Name="MoreActionsButton" Style="{StaticResource VsIconButton}" Content="⋯" ToolTip="More Actions..." Click="MoreActions_Click" FontSize="14" Width="26" Height="26" Margin="4,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ROW 1: MAIN VIEWS -->
        <Grid Grid.Row="1">
            <!-- 1. CHANGES VIEW (VS CODE SOURCE CONTROL PRIMARY VIEW) -->
            <Grid x:Name="ChangesViewGrid" Visibility="Visible">
                <Grid.ColumnDefinitions>
                    <!-- Left Sidebar (Commit & Changes Tree) -->
                    <ColumnDefinition Width="320" MinWidth="220" />
                    <!-- Splitter -->
                    <ColumnDefinition Width="3" />
                    <!-- Right Diff Viewer -->
                    <ColumnDefinition Width="*" MinWidth="300" />
                </Grid.ColumnDefinitions>

                <!-- Left Sidebar -->
                <Border Grid.Column="0" Background="{DynamicResource VsSidebarBrush}" BorderBrush="{DynamicResource VsBorderBrush}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Commit Area -->
                            <RowDefinition Height="Auto" />
                            <!-- Scrollable Changes Lists -->
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- VS Code Commit Input Area -->
                        <Border Grid.Row="0" Padding="12,10,12,10" BorderBrush="{DynamicResource VsBorderBrush}" BorderThickness="0,0,0,1">
                            <StackPanel>
                                <Grid>
                                    <TextBox x:Name="CommitMessageBox" Height="62" AcceptsReturn="True" TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto" Padding="7,6" TextChanged="CommitMessageBox_TextChanged"
                                             KeyDown="CommitMessageBox_KeyDown" />
                                    <TextBlock x:Name="CommitPlaceholder" Text="Message (Ctrl+Enter to commit)"
                                               Foreground="{DynamicResource VsPlaceholderBrush}" FontSize="12"
                                               Margin="8,7,0,0" IsHitTestVisible="False" VerticalAlignment="Top" />
                                </Grid>
                                <Button x:Name="CommitButton" Style="{StaticResource VsPrimaryButtonStyle}"
                                        Content="✓ Commit" Margin="0,7,0,0" Height="28" Click="Commit_Click" />
                            </StackPanel>
                        </Border>

                        <!-- Changes Accordion Tree -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,2,0,10">
                                <!-- STAGED CHANGES SECTION -->
                                <Border x:Name="StagedSection" Background="{DynamicResource VsHeaderBrush}" BorderThickness="0,0,0,1"
                                        BorderBrush="{DynamicResource VsBorderBrush}" Padding="8,4" Cursor="Hand"
                                        MouseLeftButtonDown="StagedHeader_Click" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock x:Name="StagedChevron" Text="▼" FontSize="9" Margin="0,1,6,0" Foreground="{DynamicResource VsMutedTextBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="STAGED CHANGES" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource VsTextBrush}" VerticalAlignment="Center" />
                                            <Border Background="{DynamicResource VsHoverBrush}" CornerRadius="8" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="StagedCountText" Text="0" FontSize="10" Foreground="{DynamicResource VsMutedTextBrush}" FontWeight="SemiBold" />
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource VsIconButton}" Content="−" ToolTip="Unstage All Changes" Click="UnstageAll_Click" Width="20" Height="20" Margin="0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <ListBox x:Name="StagedListBox" ItemTemplate="{StaticResource StagedChangeTemplate}"
                                         SelectionChanged="StagedListBox_SelectionChanged" Visibility="Collapsed" />

                                <!-- CHANGES SECTION (UNSTAGED) -->
                                <Border x:Name="UnstagedSection" Background="{DynamicResource VsHeaderBrush}" BorderThickness="0,0,0,1"
                                        BorderBrush="{DynamicResource VsBorderBrush}" Padding="8,4" Cursor="Hand"
                                        MouseLeftButtonDown="UnstagedHeader_Click" Margin="0,2,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock x:Name="UnstagedChevron" Text="▼" FontSize="9" Margin="0,1,6,0" Foreground="{DynamicResource VsMutedTextBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="CHANGES" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource VsTextBrush}" VerticalAlignment="Center" />
                                            <Border Background="{DynamicResource VsHoverBrush}" CornerRadius="8" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="UnstagedCountText" Text="0" FontSize="10" Foreground="{DynamicResource VsMutedTextBrush}" FontWeight="SemiBold" />
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource VsIconButton}" Content="↩" ToolTip="Discard All Changes" Click="DiscardAll_Click" Width="20" Height="20" Margin="0,0,4,0" />
                                            <Button Style="{StaticResource VsIconButton}" Content="+" ToolTip="Stage All Changes" Click="StageAll_Click" Width="20" Height="20" Margin="0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <ListBox x:Name="UnstagedListBox" ItemTemplate="{StaticResource UnstagedChangeTemplate}"
                                         SelectionChanged="UnstagedListBox_SelectionChanged" />

                                <!-- Working Tree Clean Placeholder -->
                                <Border x:Name="NoChangesPanel" Padding="14,24" Visibility="Collapsed">
                                    <TextBlock Text="No changes detected in the working tree." Foreground="{DynamicResource VsMutedTextBrush}"
                                               FontSize="12" HorizontalAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Splitter -->
                <GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              Background="{DynamicResource VsBorderBrush}" ResizeBehavior="PreviousAndNext" />

                <!-- Right Diff Viewer -->
                <Grid Grid.Column="2" Background="{DynamicResource VsDiffBackgroundBrush}">
                    <Grid.RowDefinitions>
                        <!-- Diff Tab Header -->
                        <RowDefinition Height="34" />
                        <!-- Diff Content -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Diff Header Bar -->
                    <Border x:Name="DiffHeaderPanel" Grid.Row="0" Background="{DynamicResource VsDiffHeaderBarBrush}"
                            BorderThickness="0,0,0,1" BorderBrush="{DynamicResource VsBorderBrush}" Padding="12,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="DiffTitle" Text="Select a file to inspect diff" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource VsTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="DiffPath" Text="" FontSize="11" Foreground="{DynamicResource VsMutedTextBrush}"
                                           Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="DiffStageButton" Style="{StaticResource VsSecondaryButtonStyle}" Content="+ Stage"
                                        ToolTip="Stage this file" Click="DiffStageButton_Click" Margin="0,0,6,0" Visibility="Collapsed" />
                                <Button x:Name="DiffDiscardButton" Style="{StaticResource VsSecondaryButtonStyle}" Content="↩ Discard"
                                        ToolTip="Discard changes in this file" Click="DiffDiscardButton_Click" Margin="0,0,6,0" Visibility="Collapsed" />
                                <Button x:Name="DiffUnstageButton" Style="{StaticResource VsSecondaryButtonStyle}" Content="− Unstage"
                                        ToolTip="Unstage this file" Click="DiffUnstageButton_Click" Margin="0" Visibility="Collapsed" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Diff Document -->
                    <RichTextBox x:Name="DiffViewer" Grid.Row="1" IsReadOnly="True" IsDocumentEnabled="False"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" FontSize="12" Background="{DynamicResource VsDiffBackgroundBrush}"
                                 Foreground="{DynamicResource VsTextBrush}" BorderThickness="0" Padding="0" />
                </Grid>

                <!-- Not a Repository Overlay -->
                <Border x:Name="NoRepositoryPanel" Grid.ColumnSpan="3" Background="{DynamicResource VsBackgroundBrush}"
                        Padding="24" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380">
                        <TextBlock Text="No Git Repository" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource VsTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                        <TextBlock Text="The current folder is not a Git repository. You can initialize a new repository or open an existing Git project." TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource VsMutedTextBrush}" Margin="0,0,0,20" />
                        <Button Style="{StaticResource VsPrimaryButtonStyle}" Content="Initialize Repository" Click="InitializeRepository_Click" Height="32" Margin="0,0,0,10" />
                        <Button Style="{StaticResource VsSecondaryButtonStyle}" Content="Open Folder..." Click="OpenRepository_Click" Height="30" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 2. COMMITS / HISTORY VIEW -->
            <Grid x:Name="CommitsViewGrid" Visibility="Collapsed" Background="{DynamicResource VsBackgroundBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380" MinWidth="260" />
                    <ColumnDefinition Width="3" />
                    <ColumnDefinition Width="*" MinWidth="300" />
                </Grid.ColumnDefinitions>

                <!-- Commits List Column -->
                <Border Grid.Column="0" Background="{DynamicResource VsSidebarBrush}" BorderBrush="{DynamicResource VsBorderBrush}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Background="{DynamicResource VsHeaderBrush}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource VsBorderBrush}" Padding="12,0">
                            <TextBlock Text="COMMITS" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource VsTextBrush}" VerticalAlignment="Center" />
                        </Border>
                        <ListBox x:Name="HistoryList" Grid.Row="1" SelectionChanged="HistoryList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2">
                                        <TextBlock Text="{Binding Subject}" FontWeight="SemiBold" Foreground="{DynamicResource VsTextBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="11" Foreground="{DynamicResource VsMutedTextBrush}" Margin="0,1,0,0">
                                            <Run Text="{Binding ShortHash}" Foreground="{DynamicResource VsPrimaryButtonBrush}" /><Run Text="  ·  " /><Run Text="{Binding Author}" /><Run Text="  ·  " /><Run Text="{Binding Date}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Border Grid.Row="2" Padding="10,8" BorderBrush="{DynamicResource VsBorderBrush}" BorderThickness="0,1,0,0">
                            <Button Content="Load older commits" Style="{StaticResource VsSecondaryButtonStyle}" Click="LoadOlderHistory_Click" HorizontalAlignment="Stretch" Height="28" />
                        </Border>
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              Background="{DynamicResource VsBorderBrush}" ResizeBehavior="PreviousAndNext" />

                <!-- Commit Details & Diff Column -->
                <Grid Grid.Column="2" Background="{DynamicResource VsDiffBackgroundBrush}">
                    <Grid.RowDefinitions>
                        <!-- Actions bar -->
                        <RowDefinition Height="36" />
                        <!-- Files & Diff Split -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{DynamicResource VsHeaderBrush}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource VsBorderBrush}" Padding="10,0">
                        <DockPanel LastChildFill="False">
                            <Button Content="Check out commit" Style="{StaticResource VsSecondaryButtonStyle}" Click="CheckoutCommit_Click" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <Button Content="Revert commit" Style="{StaticResource VsSecondaryButtonStyle}" Click="RevertCommit_Click" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <Button Content="Restore selected file" Style="{StaticResource VsSecondaryButtonStyle}" Click="RestoreHistoricalFile_Click" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" MinWidth="150" />
                            <ColumnDefinition Width="3" />
                            <ColumnDefinition Width="*" MinWidth="200" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource VsSidebarBrush}" BorderBrush="{DynamicResource VsBorderBrush}" BorderThickness="0,0,1,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="28" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Background="{DynamicResource VsHeaderBrush}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource VsBorderBrush}" Padding="8,0">
                                    <TextBlock Text="CHANGED FILES" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource VsMutedTextBrush}" VerticalAlignment="Center" />
                                </Border>
                                <ListBox x:Name="CommitFilesList" Grid.Row="1" SelectionChanged="CommitFilesList_SelectionChanged" />
                            </Grid>
                        </Border>
                        <GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                      Background="{DynamicResource VsBorderBrush}" ResizeBehavior="PreviousAndNext" />
                        <RichTextBox x:Name="HistoryDiffViewer" Grid.Column="2" IsReadOnly="True" IsDocumentEnabled="False"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     FontFamily="Consolas" FontSize="12" Background="{DynamicResource VsDiffBackgroundBrush}"
                                     Foreground="{DynamicResource VsTextBrush}" BorderThickness="0" Padding="0" />
                    </Grid>
                </Grid>
            </Grid>

            <!-- 3. BRANCHES & REMOTES VIEW -->
            <Grid x:Name="BranchesViewGrid" Visibility="Collapsed" Background="{DynamicResource VsBackgroundBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360" MinWidth="260" />
                    <ColumnDefinition Width="3" />
                    <ColumnDefinition Width="*" MinWidth="300" />
                </Grid.ColumnDefinitions>

                <!-- Branches Column -->
                <Border Grid.Column="0" Background="{DynamicResource VsSidebarBrush}" BorderBrush="{DynamicResource VsBorderBrush}" BorderThickness="0,0,1,0" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="BRANCHES" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource VsTextBrush}" Margin="0,0,0,10" />
                        <ListBox x:Name="BranchesList" Grid.Row="1">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock Text="{Binding Display}" Foreground="{DynamicResource VsTextBrush}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Upstream}" Foreground="{DynamicResource VsMutedTextBrush}" Margin="8,0,0,0" FontSize="11" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Grid.Row="2" Margin="0,12,0,0">
                            <TextBlock Text="New branch" FontSize="11" Foreground="{DynamicResource VsMutedTextBrush}" Margin="0,0,0,4" />
                            <TextBox x:Name="NewBranchBox" Height="28" Margin="0,0,0,8" />
                            <WrapPanel>
                                <Button Content="Create" Style="{StaticResource VsPrimaryButtonStyle}" Click="CreateBranch_Click" Margin="0,0,6,0" />
                                <Button Content="Switch" Style="{StaticResource VsSecondaryButtonStyle}" Click="SwitchBranch_Click" Margin="0,0,6,0" />
                                <Button Content="Delete" Style="{StaticResource VsSecondaryButtonStyle}" Click="DeleteBranch_Click" />
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              Background="{DynamicResource VsBorderBrush}" ResizeBehavior="PreviousAndNext" />

                <!-- Remotes & Clone Column -->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel MaxWidth="540" HorizontalAlignment="Left">
                        <TextBlock Text="REMOTES" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource VsTextBrush}" Margin="0,0,0,8" />
                        <TextBox x:Name="RemotesText" Height="90" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11.5" />
                        <TextBlock Text="Remote name" Foreground="{DynamicResource VsMutedTextBrush}" FontSize="11" Margin="0,12,0,4" />
                        <TextBox x:Name="RemoteNameBox" Height="28" />
                        <TextBlock Text="Remote URL" Foreground="{DynamicResource VsMutedTextBrush}" FontSize="11" Margin="0,8,0,4" />
                        <TextBox x:Name="RemoteUrlBox" Height="28" />
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="Add remote" Style="{StaticResource VsPrimaryButtonStyle}" Click="AddRemote_Click" Margin="0,0,6,0" />
                            <Button Content="Set URL" Style="{StaticResource VsSecondaryButtonStyle}" Click="SetRemoteUrl_Click" Margin="0,0,6,0" />
                            <Button Content="Remove remote" Style="{StaticResource VsSecondaryButtonStyle}" Click="RemoveRemote_Click" />
                        </WrapPanel>

                        <Separator Margin="0,20,0,16" Background="{DynamicResource VsBorderBrush}" />

                        <TextBlock Text="CLONE A REPOSITORY" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource VsTextBrush}" Margin="0,0,0,8" />
                        <TextBlock Text="Repository URL" Foreground="{DynamicResource VsMutedTextBrush}" FontSize="11" Margin="0,0,0,4" />
                        <TextBox x:Name="CloneUrlBox" Height="28" />
                        <TextBlock Text="Destination folder" Foreground="{DynamicResource VsMutedTextBrush}" FontSize="11" Margin="0,8,0,4" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="CloneDestinationBox" Height="28" />
                            <Button Grid.Column="1" Content="Browse..." Style="{StaticResource VsSecondaryButtonStyle}" Click="BrowseCloneDestination_Click" Margin="6,0,0,0" Height="28" />
                        </Grid>
                        <Button Content="Clone" Style="{StaticResource VsPrimaryButtonStyle}" Click="Clone_Click" HorizontalAlignment="Left" Height="28" Width="90" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- 4. TERMINAL / CONSOLE VIEW -->
            <Grid x:Name="TerminalViewGrid" Visibility="Collapsed" Background="{DynamicResource VsBackgroundBrush}" Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="GIT TERMINAL &amp; COMMAND OUTPUT" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource VsMutedTextBrush}" Margin="0,0,0,8" />
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="GitCommandBox" Text="status" Height="30" VerticalContentAlignment="Center" KeyDown="GitCommandBox_KeyDown" />
                    <Button Grid.Column="1" Content="Run" Style="{StaticResource VsPrimaryButtonStyle}" Click="RunGitCommand_Click" Margin="8,0,0,0" Height="30" />
                    <Button Grid.Column="2" Content="Run in terminal" Style="{StaticResource VsSecondaryButtonStyle}" Click="RunInteractiveGitCommand_Click" Margin="6,0,0,0" Height="30" />
                </Grid>
                <TextBox x:Name="CommandOutputText" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"
                         Background="{DynamicResource VsInputBackgroundBrush}" Foreground="{DynamicResource VsTextBrush}"
                         BorderBrush="{DynamicResource VsInputBorderBrush}" Padding="8" />
            </Grid>
        </Grid>

        <!-- ROW 2: VS CODE BOTTOM STATUS BAR -->
        <Border Grid.Row="2" Background="{DynamicResource VsStatusBarBrush}" Height="24" Padding="8,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- Branch Switcher Button -->
                <Button x:Name="BranchStatusButton" Style="{StaticResource VsIconButton}" Click="BranchStatusButton_Click"
                        ToolTip="Current branch (Click to switch)" Width="Auto" Height="22" Padding="6,0" Margin="0,0,6,0"
                        Foreground="{DynamicResource VsStatusBarTextBrush}">
                    <TextBlock x:Name="BranchStatusButtonText" Text="⑂ No repository" FontSize="11" Foreground="{DynamicResource VsStatusBarTextBrush}" />
                </Button>
                <!-- Sync Button -->
                <Button x:Name="SyncButton" Grid.Column="1" Style="{StaticResource VsIconButton}" Click="SyncButton_Click"
                        ToolTip="Synchronize changes with remote (Pull then Push)" Width="Auto" Height="22" Padding="6,0" Margin="0,0,10,0"
                        Foreground="{DynamicResource VsStatusBarTextBrush}">
                    <TextBlock Text="↻ Sync" FontSize="11" Foreground="{DynamicResource VsStatusBarTextBrush}" />
                </Button>
                <!-- Status Message -->
                <TextBlock x:Name="StatusText" Grid.Column="2" Text="Ready" FontSize="11" Foreground="{DynamicResource VsStatusBarTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <!-- Repository Path Status -->
                <TextBlock x:Name="RepositoryStatusText" Grid.Column="3" Text="" FontSize="11" Foreground="{DynamicResource VsStatusBarTextBrush}" Opacity="0.85" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
