<Window x:Class="Typify.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Typify.TextBox;assembly=TypifyTextbox"
        xmlns:typify="clr-namespace:Typify"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="Typify" Height="820" Width="1320"
        MinHeight="700" MinWidth="1120"
        WindowStyle="None" ResizeMode="CanResize" StateChanged="MainWindow_StateChanged"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13"
        SourceInitialized="MainWindow_SourceInitialized" Loaded="MainWindow_Loaded" Closed="MainWindow_Closed">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#F3F3F3" />
        <SolidColorBrush x:Key="SidebarBrush" Color="#F3F3F3" />
        <SolidColorBrush x:Key="BorderBrush" Color="#E5E5E5" />
        <SolidColorBrush x:Key="TextBrush" Color="#333333" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#616161" />
        <SolidColorBrush x:Key="AccentBrush" Color="#007ACC" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#0062A3" />
        <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="GitBrush" Color="#F03C2E" />
        <SolidColorBrush x:Key="HoverBrush" Color="#E8E8E8" />
        <SolidColorBrush x:Key="SelectedBrush" Color="#E4E6F1" />
        <SolidColorBrush x:Key="EditorBackgroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="EditorTextBrush" Color="#333333" />
        <SolidColorBrush x:Key="DiagnosticBackgroundBrush" Color="#FFF2F1" />
        <SolidColorBrush x:Key="DiagnosticTextBrush" Color="#CF222E" />
        <SolidColorBrush x:Key="PreviewPageBorderBrush" Color="#E5E5E5" />
        <SolidColorBrush x:Key="WindowCaptionButtonHoverBrush" Color="#E0E0E0" />
        <SolidColorBrush x:Key="WindowCloseButtonHoverBrush" Color="#C42B1C" />

        <Style x:Key="TopMenuItemStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Padding" Value="8,10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TopMenuContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="HasDropShadow" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}" CornerRadius="2"
                                SnapsToDevicePixels="True">
                            <StackPanel IsItemsHost="True"
                                        KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TopMenuContextMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="MenuItemChrome" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" ContentSource="Icon"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <ContentPresenter Grid.Column="1" ContentSource="Header"
                                                  Margin="8,0,0,0" RecognizesAccessKey="True"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="MenuItemChrome" Property="Background"
                                        Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TopMenuSeparatorStyle" TargetType="Separator">
            <Setter Property="Margin" Value="6,3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="{DynamicResource BorderBrush}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource HoverBrush}" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PrimaryChrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PrimaryChrome" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                                <Setter TargetName="PrimaryChrome" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PrimaryChrome" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PrimaryChrome" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="TextBoxChrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="TextBoxChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TreeView">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Padding" Value="2,1" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ToggleButton x:Name="Expander" Grid.Row="0" Grid.Column="0" Width="16" Height="24"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                        Focusable="False" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource MutedTextBrush}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                            <TextBlock x:Name="Chevron" Text="›" FontSize="18" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" Margin="0,-2,0,0" Foreground="{TemplateBinding Foreground}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chevron" Property="Text" Value="⌄" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Border x:Name="HeaderBorder" Grid.Row="0" Grid.Column="1" CornerRadius="5" Padding="{TemplateBinding Padding}"
                                    Background="Transparent" SnapsToDevicePixels="True">
                                <ContentPresenter x:Name="PART_Header" ContentSource="Header" HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1" Margin="2,0,0,0" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                            </Trigger>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource SelectedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                <Setter Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabChrome" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                <Setter TargetName="TabChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WindowCaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CaptionButtonChrome" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CaptionButtonChrome" Property="Background" Value="{DynamicResource WindowCaptionButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CaptionButtonChrome" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WindowCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowCaptionButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CaptionButtonChrome" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CaptionButtonChrome" Property="Background" Value="{DynamicResource WindowCloseButtonHoverBrush}" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CaptionButtonChrome" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid x:Name="mainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Border Width="16" Height="16" CornerRadius="3" Background="{DynamicResource AccentBrush}"
                            VerticalAlignment="Center">
                        <TextBlock Text="T" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Typify" Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextBrush}" FontSize="12" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="MinimizeWindowButton" Style="{StaticResource WindowCaptionButtonStyle}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="MinimizeWindowButton_Click"
                            ToolTip="Minimize">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                    </Button>
                    <Button x:Name="MaximizeWindowButton" Style="{StaticResource WindowCaptionButtonStyle}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="MaximizeWindowButton_Click"
                            ToolTip="Maximize">
                        <TextBlock x:Name="MaximizeWindowGlyph" Text="&#xE923;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                    </Button>
                    <Button x:Name="CloseWindowButton" Style="{StaticResource WindowCloseButtonStyle}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="CloseWindowButton_Click"
                            ToolTip="Close">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="8,0">


                <Border Style="{StaticResource TopMenuItemStyle}"
                        PreviewMouseLeftButtonDown="TopMenuItem_PreviewMouseLeftButtonDown">
                    <Border.ContextMenu>
                        <ContextMenu Style="{StaticResource TopMenuContextMenuStyle}">
                            <MenuItem Header="New" Style="{StaticResource TopMenuContextMenuItemStyle}" />
                            <MenuItem Header="Open" Style="{StaticResource TopMenuContextMenuItemStyle}" />
                            <Separator Style="{StaticResource TopMenuSeparatorStyle}" />
                            <MenuItem Header="Save" Style="{StaticResource TopMenuContextMenuItemStyle}">
                                <MenuItem.Icon>
                                    <Path Data="{x:Static typify:MainWindow.SaveGeometry}"
                                          Fill="{DynamicResource TextBrush}" Width="14" Height="14"
                                          Stretch="Uniform" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Save As..." Style="{StaticResource TopMenuContextMenuItemStyle}" />
                            <Separator Style="{StaticResource TopMenuSeparatorStyle}" />
                            <MenuItem Header="Print" Style="{StaticResource TopMenuContextMenuItemStyle}" >
                                <MenuItem.Icon>
                                    <Path Data="{x:Static typify:MainWindow.PrintGeometry}"
                                          Fill="{DynamicResource TextBrush}" Width="14" Height="14"
                                          Stretch="Uniform" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Export PDF..." Style="{StaticResource TopMenuContextMenuItemStyle}"
                                      Click="ExportPdf_Click" />
                            <Separator Style="{StaticResource TopMenuSeparatorStyle}" />
                            <MenuItem Header="Preferences" Style="{StaticResource TopMenuContextMenuItemStyle}" />
                            <Separator Style="{StaticResource TopMenuSeparatorStyle}" />
                            <MenuItem Header="Exit" Style="{StaticResource TopMenuContextMenuItemStyle}"
                                      Click="CloseWindowButton_Click" />
                        </ContextMenu>
                    </Border.ContextMenu>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="File" FontSize="11" FontWeight="SemiBold"
                                Foreground="{DynamicResource TextBrush}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource TopMenuItemStyle}"
                        PreviewMouseLeftButtonDown="TopMenuItem_PreviewMouseLeftButtonDown">
                    <Border.ContextMenu>
                        <ContextMenu Style="{StaticResource TopMenuContextMenuStyle}">
                            <MenuItem Header="Undo" Tag="Undo" Style="{StaticResource TopMenuContextMenuItemStyle}"
                                      Click="EditorEditCommand_Click" >
                                <MenuItem.Icon>
                                    <Path Data="{x:Static typify:MainWindow.UndoGeometry}"
                                          Stroke="{DynamicResource TextBrush}" 
                                          StrokeThickness="1.5" 
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Width="14" Height="14"
                                          Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform>
                                            <ScaleTransform ScaleX="-1.0" />
                                        </Path.RenderTransform>
                                    </Path>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Redo" Tag="Redo" Style="{StaticResource TopMenuContextMenuItemStyle}"
                                      Click="EditorEditCommand_Click" >
                                <MenuItem.Icon>
                                    <Path Data="{x:Static typify:MainWindow.UndoGeometry}"
                                          Stroke="{DynamicResource TextBrush}" 
                                          StrokeThickness="1.5" 
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Width="14" Height="14"
                                          Stretch="Uniform" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator Style="{StaticResource TopMenuSeparatorStyle}" />
                            <MenuItem Header="Cut" Tag="Cut" Style="{StaticResource TopMenuContextMenuItemStyle}"
                                      Click="EditorEditCommand_Click" >
                                <MenuItem.Icon>
                                    <Path Data="{x:Static typify:MainWindow.CutGeometry}"
                                          Fill="{DynamicResource TextBrush}" Width="14" Height="14"
                                          Stretch="Uniform" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Copy" Tag="Copy" Style="{StaticResource TopMenuContextMenuItemStyle}"
                                      Click="EditorEditCommand_Click" >
                                <MenuItem.Icon>
                                    <Path Data="{x:Static typify:MainWindow.CopyGeometry}"
                                          Fill="{DynamicResource TextBrush}" Width="14" Height="14"
                                          Stretch="Uniform" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Paste" Tag="Paste" Style="{StaticResource TopMenuContextMenuItemStyle}"
                                      Click="EditorEditCommand_Click" >
                                <MenuItem.Icon>
                                    <Path Data="{x:Static typify:MainWindow.PasteGeometry}"
                                          Stroke="{DynamicResource TextBrush}" Width="14" Height="14"
                                          Stretch="Uniform" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator Style="{StaticResource TopMenuSeparatorStyle}" />
                            <MenuItem Header="Select All" Tag="SelectAll"
                                      Style="{StaticResource TopMenuContextMenuItemStyle}"
                                      Click="EditorEditCommand_Click" />
                        </ContextMenu>
                    </Border.ContextMenu>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Edit" FontSize="11" FontWeight="SemiBold"
                                Foreground="{DynamicResource TextBrush}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource TopMenuItemStyle}"
                        PreviewMouseLeftButtonDown="TopMenuItem_PreviewMouseLeftButtonDown">
                    <Border.ContextMenu>
                        <ContextMenu Style="{StaticResource TopMenuContextMenuStyle}">
                            <MenuItem Header="Toggle Live Preview" Style="{StaticResource TopMenuContextMenuItemStyle}"
                                      Click="LivePreviewButton_Click" />
                            <MenuItem Header="Toggle Dark Mode" Style="{StaticResource TopMenuContextMenuItemStyle}"
                                      Click="ThemeToggleButton_Click">
                                <MenuItem.Icon>
                                    <Path Data="{x:Static typify:MainWindow.DarkModeGeometry}"
                                          Fill="{DynamicResource TextBrush}" Width="14" Height="14"
                                          Stretch="Uniform" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Style="{StaticResource TopMenuContextMenuItemStyle}">
                                <MenuItem.Header>Toggle Git Window</MenuItem.Header>
                                <MenuItem.Icon>
                                    <Path Data="{x:Static typify:MainWindow.GitGeometry}"
                                          Fill="{DynamicResource GitBrush}" Width="14" Height="14"
                                          Stretch="Uniform">
                                        <Path.LayoutTransform>
                                            <RotateTransform Angle="-45" />
                                        </Path.LayoutTransform>
                                    </Path>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </Border.ContextMenu>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="View" FontSize="11" FontWeight="SemiBold"
                                Foreground="{DynamicResource TextBrush}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource TopMenuItemStyle}"
                        PreviewMouseLeftButtonDown="TopMenuItem_PreviewMouseLeftButtonDown">
                    <Border.ContextMenu>
                        <ContextMenu Style="{StaticResource TopMenuContextMenuStyle}">
                            <MenuItem Header="Git Changes" Style="{StaticResource TopMenuContextMenuItemStyle}"
                                      Click="GitChangesMenuItem_Click" />
                        </ContextMenu>
                    </Border.ContextMenu>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Git" FontSize="11" FontWeight="SemiBold"
                                Foreground="{DynamicResource TextBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <Grid x:Name="OverlayHost" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT VERTICAL TOOL TAB STRIP (Visual Studio style) -->
            <Border x:Name="LeftToolBar" Grid.Column="0" Background="{DynamicResource SidebarBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Width="26">
                <StackPanel VerticalAlignment="Top" Margin="0,10,0,0">
                    <!-- Explorer Tab Button -->
                    <Border x:Name="LeftExplorerTab" CornerRadius="3" Margin="2,0,2,0" Padding="3,10"
        Cursor="Hand" ToolTip="Explorer"
        MouseEnter="LeftGitChangesTab_MouseEnter"
                            MouseLeftButtonDown="LeftGitChangesTab_MouseLeftButtonDown"
        Background="Transparent">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Explorer" FontSize="11" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextBrush}">
                                <TextBlock.LayoutTransform>
                                    <RotateTransform Angle="90" />
                                </TextBlock.LayoutTransform>
                            </TextBlock>
                        </StackPanel>
                    </Border>


                    <!-- Git Changes Tab Button -->
                    <Border x:Name="LeftGitChangesTab" CornerRadius="3" Margin="2,0,2,0" Padding="3,10"
        Cursor="Hand" ToolTip="Git Changes (Ctrl+Shift+C)"
        Background="Transparent"
        MouseLeftButtonDown="LeftGitChangesTab_MouseLeftButtonDown"
        MouseEnter="LeftGitChangesTab_MouseEnter"
        MouseLeave="LeftGitChangesTab_MouseLeave">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Git Changes" FontSize="11" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextBrush}">
                                <TextBlock.LayoutTransform>
                                    <RotateTransform Angle="90" />
                                </TextBlock.LayoutTransform>
                            </TextBlock>
                            <!-- Badge for staged changes count -->
                            <Border x:Name="LeftGitChangesBadge" Background="{DynamicResource AccentBrush}" CornerRadius="6"
                Padding="4,1" Margin="0,8,0,0" HorizontalAlignment="Center" Visibility="Collapsed">
                                <TextBlock x:Name="LeftGitChangesBadgeText" Text="0" FontSize="9" FontWeight="Bold"
                       Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
            <Grid Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition x:Name="SplitterGrid" Width="0" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TabControl x:Name="dockedOverlayTabs" Grid.Column="0" Visibility="Collapsed"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <TabControl.Template>
                        <ControlTemplate TargetType="{x:Type TabControl}">
                            <Grid ClipToBounds="True" KeyboardNavigation.TabNavigation="Local">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TabPanel x:Name="HeaderPanel" Grid.Row="0" IsItemsHost="True"
                                          Background="{DynamicResource SidebarBrush}" />
                                <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1,0,1,1" Background="{DynamicResource SurfaceBrush}">
                                    <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"
                                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </TabControl.Template>
                </TabControl>
                <GridSplitter x:Name="DockedOverlaySplitter" Grid.Column="1" Width="5"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              Background="Transparent" Cursor="SizeWE"
                              ResizeBehavior="PreviousAndNext" Visibility="Collapsed" />

                <TabControl x:Name="MainTabs" Grid.Column="2" Margin="10,6,10,6">
                    <TabItem Header="Workspace">
                        <Grid Margin="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="EditorColumn" Width="*" MinWidth="240" />
                                <ColumnDefinition x:Name="PreviewSplitterColumn" Width="0" />
                                <ColumnDefinition x:Name="PreviewColumn" Width="0" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Margin="8,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <controls:TypifyTextbox x:Name="Editor" Grid.Row="1" ShowBorder="True"
                                        IsHorizontalScrollEnabled="True"
                                        Background="{DynamicResource EditorBackgroundBrush}"
                                        Foreground="{DynamicResource EditorTextBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        CaretBrush="{DynamicResource TextBrush}"
                                        Text="= Hello, Typst&#x0a;&#x0a;Write Typst source here.&#x0a;&#x0a;#let answer = 42&#x0a;The answer is *#answer*." />
                            </Grid>
                            <GridSplitter x:Name="PreviewSplitter" Grid.Column="1" Width="6"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                          Background="Transparent" ResizeBehavior="PreviousAndNext"
                                          Visibility="Collapsed" />
                            <Border x:Name="PreviewPanel" Grid.Column="2" Margin="8,0,0,0" Padding="12"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10"
                                    Visibility="Collapsed">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="PREVIEW" FontWeight="SemiBold" FontSize="11"
                               Foreground="{DynamicResource MutedTextBrush}" Margin="0,1,0,7" />
                                    <TextBlock x:Name="PreviewStatus" Grid.Row="1" Text="Live preview is off"
                               Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,0,0,10" />
                                    <ScrollViewer x:Name="PreviewScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" SizeChanged="PreviewScroll_SizeChanged">
                                        <StackPanel x:Name="PageHost" HorizontalAlignment="Center" />
                                    </ScrollViewer>
                                    <TextBox x:Name="PreviewDiagnostics" Grid.Row="3" Height="110" Margin="0,10,0,0"
                             IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource DiagnosticTextBrush}"
                             Background="{DynamicResource DiagnosticBackgroundBrush}"
                             BorderBrush="{DynamicResource BorderBrush}" Visibility="Collapsed" />
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Git">
                        <typify:GitTabView x:Name="GitView" />
                    </TabItem>
                </TabControl>

            </Grid>
            <!-- Overlapping Git Changes Window (Docked on the left, overlapping MainTabs) -->
            <typify:GitCommitOverlay x:Name="CommitOverlay" Grid.Column="1" Panel.ZIndex="100"
                                 HorizontalAlignment="Left" VerticalAlignment="Stretch" Visibility="Collapsed" />
            <typify:ExplorerOverlay x:Name="ExplorerOverlay" Grid.Column="1" Panel.ZIndex="100"
                                   HorizontalAlignment="Left" VerticalAlignment="Stretch" Visibility="Collapsed" />
        </Grid>

        <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,0">
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource MutedTextBrush}"
                       Text="Ready" FontSize="11" VerticalAlignment="Center" />
        </Border>
    </Grid>
</Window>
